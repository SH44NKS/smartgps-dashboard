SMARTGPS_BASE_URL=https://sp.tracker-net.app

# Recomendado: configure um hash novo no Vercel.
SMARTGPS_API_HASH=

# Alternativa: login dinamico se nao houver SMARTGPS_API_HASH.
SMARTGPS_EMAIL=
SMARTGPS_PASSWORD=

# Opcional: permite salvar a aba Links direto no GitHub.
# Use um Fine-grained GitHub token com Contents: Read and write neste repositorio.
LINKS_GITHUB_TOKEN=
LINKS_GITHUB_REPO=SH44NKS/smartgps-dashboard
LINKS_GITHUB_BRANCH=main
LINKS_FILE_PATH=data/links.json
